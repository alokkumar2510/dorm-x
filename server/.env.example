# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dorm_x?schema=public"

# Express server listening port
PORT=5000

# Client App URL for CORS Configuration
CLIENT_URL="http://localhost:3000"

# JWT Secrets for session security
JWT_ACCESS_SECRET="generate_a_strong_random_secret_for_access_tokens"
JWT_REFRESH_SECRET="generate_a_strong_random_secret_for_refresh_tokens"

# Node environment state
NODE_ENV="development"
